# Copy to .env and fill in. .env is gitignored.

# Tailscale PRE-AUTH KEY, not an interactive login URL, and NOT tagged.
# A tagged node leaves autogroup:member, which is what grants `funnel` in the
# policy file -- a tagged key joins fine and is then refused Funnel.
# Same trap documented in stacks/secondbrain-rag.
TS_AUTHKEY=

# Shared with the website's ORIGINALS_UPLOAD_SECRET on Vercel, and with nothing
# else. Generate with: openssl rand -base64 48
ORIGINALS_UPLOAD_SECRET=

# The wedding site's exact origin, scheme included. The browser posts here
# cross-origin, so this is what goes in Access-Control-Allow-Origin.
ALLOWED_ORIGIN=https://your-wedding-domain

# Where full-resolution files land on the host.
ORIGINALS_DIR=/mnt/media/wedding-originals
