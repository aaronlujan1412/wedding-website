# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the templates that say which variables to fill in are the point.
!.env.example

# Tailscale node state for the homelab stack: a live identity, not config.
homelab/*/state/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude
CLAUDE.md
.claude-data/

# obsidian vault (personal planning notes, not project source)
/Obsidian Vault/
